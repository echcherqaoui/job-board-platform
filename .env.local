##=====================================================================
## IMAGE VERSIONS
##=====================================================================
POSTGRES_VERSION=17.0
KC_VERSION=26.0.6
RD_VERSION=8.2.3-alpine
CONFLUENT_VERSION=7.7.7
DEBEZIUM_VERSION=3.1.2
PGADMIN_VERSION=9.3
KF_UI_VERSION=v1.4.2
TERRAFORM_VERSION=1.14
PROMETHEUS_VERSION=v3.10.0
GRAFANA_VERSION=12.4.1
TEMPO_VERSION=2.10.1
LOKI_VERSION=3.3.4
PROMTAIL_VERSION=3.3.4

##=====================================================================
## REDIS
##=====================================================================
RD_HOST=localhost
RD_PORT=6379
RD_PASSWORD=SuperStrongPassword789

##=====================================================================
## POSTGRESQL
##=====================================================================
PG_SERVICE=postgres
PG_PORT=5432
DATASOURCE_USERNAME=user
DATASOURCE_PASSWORD=pass
PG_DB=postgres
PG_INIT_PATH=./init-db.sql

##=====================================================================
## PGADMIN
##=====================================================================
PGADMIN_PORT_HOST=8000
PGADMIN_DEFAULT_EMAIL=admin@event.com
PGADMIN_DEFAULT_PASSWORD=SuperStrongPassword123

##=====================================================================
## DISCOVERY SERVICE
##=====================================================================
DISCOVERY_PORT=8761
DISCOVERY_SERVICE_URL=http://localhost:8761/eureka/

##=====================================================================
## BFF SERVICE
##=====================================================================
BFF_PORT=8080

##=====================================================================
## AUTH SERVICE
##=====================================================================
# Database
DATASOURCE_URL=jdbc:postgresql://localhost:5432/auth_db

# OAuth2 Client Registration
AUTH_CLIENT_ID=bff-client
AUTH_CLIENT_SECRET=bff-secret
AUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/bff-client

# Server
AUTH_SERVICE_PORT=8081
AUTH_ISSUER_URI=http://localhost:8081
POST_LOGOUT_REDIRECT_URI=http://localhost:8080/login
KEYSTORE_PATH=job-board.jks
KEYSTORE_PASSWORD=SuperStrongPassword
KEY_ALIAS=job-board-key

# Token Settings
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=7d
REQUIRE_CONSENT=false
REQUIRE_PKCE=true

# Logging
LOG_LEVEL_SECURITY=TRACE
LOG_LEVEL_OAUTH2=TRACE
LOG_LEVEL_GATEWAY=TRACE